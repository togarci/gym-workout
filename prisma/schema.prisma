generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model Role {
  id    Int    @id @default(autoincrement())
  name  String @unique // "personal" | "global"
  users User[]
}

// Apenas credenciais de login
model User {
  id        Int      @id @default(autoincrement())
  userName  String   @unique @map("user_name")
  email     String   @unique
  password  String
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  roleId Int?  @map("role_id")
  role   Role? @relation(fields: [roleId], references: [id], onDelete: SetNull)

  personal Personal?
  global   Global?

  @@index([roleId])
}

model Personal {
  id     Int     @id @default(autoincrement())
  name   String?
  userId Int     @unique @map("user_id")
  user   User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  globals Global[]
}

model Global {
  id         Int      @id @default(autoincrement())
  name       String?
  userId     Int      @unique @map("user_id")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  personalId Int      @map("personal_id")
  personal   Personal @relation(fields: [personalId], references: [id], onDelete: Cascade)

  workouts Workout[]

  @@index([personalId])
}

model Workout {
  id          Int               @id @default(autoincrement())
  name        String
  description String?
  globalId    Int
  global      Global            @relation(fields: [globalId], references: [id], onDelete: Cascade)
  exercises   WorkoutExercise[]
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt
}

model Exercise {
  id          Int               @id @default(autoincrement())
  name        String            @unique // Ex: "Supino Reto"
  muscleGroup String? // Ex: "Peito"
  workouts    WorkoutExercise[]
  createdAt   DateTime          @default(now())
}

model WorkoutExercise {
  id          Int      @id @default(autoincrement())
  workoutId   Int
  workout     Workout  @relation(fields: [workoutId], references: [id], onDelete: Cascade)
  exerciseId  Int
  exercise    Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  sets        Int      @default(3)
  reps        String   @default("10") // String para permitir valores como "8-12" ou "Falha"
  restTime    Int? // Tempo de descanso em segundos
  order       Int      @default(0) // Ordem do exercício no treino
  observation String?
  weight      String?
  tags        String[]
}
